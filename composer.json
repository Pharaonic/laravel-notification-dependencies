{
  "name": "pharaonic/laravel-notification-dependencies",
  "description": "Attach Laravel database notifications to Eloquent models and delete them automatically when any of those models is deleted.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "notifications",
    "database-notifications",
    "eloquent",
    "dependencies",
    "cleanup",
    "pharaonic"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/notification-dependencies",
    "issues": "https://github.com/Pharaonic/laravel-notification-dependencies/issues",
    "source": "https://github.com/Pharaonic/laravel-notification-dependencies"
  },
  "require": {
    "php": ">=8.2 <8.6",
    "illuminate/contracts": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/notifications": "^12.0",
    "illuminate/support": "^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.8 || ^4.0",
    "phpstan/phpstan": "^2.1.33",
    "phpunit/phpunit": "^11.5.50 || ^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\NotificationDependencies\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\NotificationDependencies\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\NotificationDependencies\\NotificationDependenciesServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
